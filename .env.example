# Optional — render-service runs fine without any of this; only /studio/:id/generate needs it.

# Which LLM answers /studio/:id/generate: "openai" (default — use this until you have an
# Anthropic key) or "anthropic" (switch back to this the moment you do; both implementations
# stay in studioGenerate.ts either way).
LLM_PROVIDER=openai

# OpenAI (used when LLM_PROVIDER=openai). Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic (used when LLM_PROVIDER=anthropic). Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional overrides
# PORT=4310

# Export queue (render-service). Exports live under ~/ReelStudioProjects/exports so they survive a
# service restart; finished files are kept RENDER_KEEP_HOURS (default 24) for download, then deleted.
# Exports render one at a time, in the order they were queued. RENDER_CONCURRENCY=<n> lets a big
# machine encode several small outputs at once (anything above 1080p still always runs alone).
# REEL_PROJECTS_ROOT=~/ReelStudioProjects
# REEL_EXPORTS_ROOT=~/ReelStudioProjects/exports
# RENDER_CONCURRENCY=1
# RENDER_KEEP_HOURS=24

# editor-ui (Vite) only reads this if you need render-service on a non-default port —
# most setups never need it.
# VITE_RENDER_SERVICE_URL=http://localhost:4310
